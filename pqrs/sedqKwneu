        // Reemplazar caracteres no válidos para nombres de clases CSS (si es necesario)
        var pageClass = pageName.replace(/[^a-z0-9\-]/gi, '-').toLowerCase(); // Convierte el nombre en una clase CSS válida
        console.log("Page class name:", "page-"+pageClass);

        // Agregar la clase al body
        if (pageClass.length > 0) {  // Asegurarse de que haya un nombre de página
            $('body').addClass('page-' + pageClass); // Agregar clase dinámica al body
        }

        // Función para actualizar el logo según el scroll y la clase del body
        function updateLogo() {
            if ($('body').hasClass('noticias-template-default') || $('body').hasClass('page-plan-referidos') || $('body').hasClass('page-pqrs' ) ) {
                $("#logo_header .elementor-widget-container img").attr("src", "/wp-content/uploads/2025/01/Group-14742.svg");
