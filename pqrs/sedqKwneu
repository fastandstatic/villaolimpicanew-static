                    $("#logo_header .elementor-widget-container img").attr("src", "/wp-content/uploads/2025/01/Group-14742.svg");
                } else {
                    $("#logo_header .elementor-widget-container img").attr("src", "/wp-content/uploads/2025/01/Logo_villa.svg");
                }
            }
        }

        // Función para actualizar el sticky del header según el scroll
        function updateStickyHeader() {
            if ($(window).scrollTop() > 20) {
                $("#head").addClass('sticky');
            } else {
                $("#head").removeClass('sticky');
            }
        }
			
				function updateStickyHeaderMovil() {
            if ($(window).scrollTop() > 20) {
                $("#headmovil").addClass('sticky');
            } else {
                $("#headmovil").removeClass('sticky');
            }
        }

        // Primero agregar la clase al body, luego ejecutar las demás funciones
        updateLogo();  // Actualizar el logo inmediatamente al cargar
        updateStickyHeader();  // Actualizar el sticky header inmediatamente al cargar
