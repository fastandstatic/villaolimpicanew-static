        // Aquí agregamos el evento de submit al formulario
        const form = document.querySelector('#form_pqrs');
        console.log("form", form);
        if (form) {
            form.addEventListener('submit', handleSubmitwp);
        } else {
            console.error("No se encontró formulario con id");
        }
    
        function handleSubmitwp(event) {

            console.log("Formulario enviado"); 
            event.preventDefault();
            event.stopPropagation();
            
            // Prepara los datos del formulario
            const formData = new FormData(event.target);
            const data = Object.fromEntries(formData.entries());
                    
            console.log('Datos a enviar a Make:', data);
        
            // Aquí puedes enviar los datos a Make.com o realizar otras acciones
            sendToMake(data);
        
            // Restablecer el formulario
            const form = event.target;
            form.reset();
        
            // Restablecer los campos select2
            $('#form-field-tipo_documento').val(null).trigger('change');
            $('#form-field-inmueble').val(null).trigger('change');
            $('#form-field-tipo_solicitud').val(null).trigger('change');
        }

        async function sendToMake(data) {
            try {
                console.log('Datos enviados a Make:', data); // Verifica los datos antes de enviarlos.
        
                const response = await fetch('https://hook.us1.make.com/uphswf0gy73hy9ublgewb78eyqnas4sc', { 
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data),
                });
        
                console.log('Estado de la respuesta:', response.status); // Imprime el estado de la respuesta.
                console.log('Respuesta completa:', response); // Imprime toda la respuesta para más contexto.
                
                if (response.ok) {
                    Swal.fire({
                        title: "Datos enviados correctamente.",
                        icon: "success",
                        confirmButtonColor: "#000000",
                        confirmButtonText: "Cerrar",
                    });
                } else {
                    const errorResponse = await response.text(); // Intenta leer el cuerpo de la respuesta en caso de error.
                    console.error('Error en la respuesta de Make.com:', errorResponse);
                    Swal.fire({
                        title: "Error al enviar los datos a Make.com.",
                        text: `Código de error: ${response.status}`,
                        icon: "error",
                        confirmButtonColor: "#000000",
                        confirmButtonText: "Cerrar",
                    });
                }
            } catch (error) {

                console.error('Error al enviar los datos:', error);
                Swal.fire({
                    title: "Error al enviar los datos.",
                    text: error.message,
                    icon: "error",
                    confirmButtonColor: "#000000",
                    confirmButtonText: "Cerrar",
                });
            }
        }

        
